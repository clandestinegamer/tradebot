# Copy this file to .env and fill it in. Never commit .env or share it.

# Password for the phone dashboard (make it long and random)
DASHBOARD_TOKEN=change-me-to-a-long-random-string

# Two-step login: run `python -m app.security totp-setup` and paste the secret here
TOTP_SECRET=

# Domain for HTTPS (docker-compose + Caddy), e.g. bot.example.com
DOMAIN=
DASHBOARD_URL=               # e.g. https://bot.example.com (used in KakaoTalk message links)

# ── Upbit (crypto) ── mypage → Open API 관리
# Enable ONLY 자산조회 + 주문조회 + 주문하기. NEVER enable 출금 (withdrawals).
# Register your server's fixed IP in the whitelist.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ── Binance (crypto, USDT pairs) ── Profile → API Management → Create API
# Tick ONLY "Enable Reading" + "Enable Spot & Margin Trading". NEVER "Enable Withdrawals".
# Choose "Restrict access to trusted IPs only" and enter your server's fixed IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Korea Investment & Securities (stocks) ── apiportal.koreainvestment.com
# KIS_ENV=demo uses the 모의투자 (mock) server with your mock-account keys.
KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678      # first 8 digits of the account number
KIS_ACCOUNT_PRODUCT=01       # last 2 digits (usually 01)

# ── Claude (AI review of buy signals) ── console.anthropic.com
ANTHROPIC_API_KEY=

# ── Alerts (optional — set up either or both) ──
# Telegram: message @BotFather → /newbot → paste the token; message your new bot once,
# then run `python -m app.alerts telegram-chat-id` to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# KakaoTalk (나에게 보내기): create an app at developers.kakao.com, paste its REST API key,
# then run `python -m app.alerts kakao-setup` once to get the refresh token.
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# Dead-man switch: a ping URL from healthchecks.io (free). If the bot stops pinging, they alert you.
HEALTHCHECK_URL=

# Encrypted secrets: instead of this file, you can run `python -m app.vault encrypt .env`,
# delete .env, and start the bot with TRADEBOT_PASSPHRASE set. See README → Security.

# ── More data (optional) ──
FINNHUB_API_KEY=             # free at finnhub.io — enables the US earnings-date filter

# ── Guardian (backup stop-keeper on a second machine) — see README → Guardian ──
GUARDIAN_TOKEN=              # long random string; the same value goes in the guardian machine's .env

# ── Backups ──
# Nightly backups are encrypted when TRADEBOT_PASSPHRASE is set, and sent to Telegram if it's set up.
# Optionally copy them anywhere with a command that gets the file path as its last argument:
BACKUP_COMMAND=              # e.g.  rclone copy --no-traverse gdrive:TradeBot
