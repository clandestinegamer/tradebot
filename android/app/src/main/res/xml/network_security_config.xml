<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS for your real server. Plain http is allowed only so you can test against
     a PC on your home Wi-Fi; the setup screen warns before using it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
